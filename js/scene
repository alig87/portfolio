/* ================================================================
   SCENE.JS — 3D rotating wireframe cubes + floating bubbles
   All drawn on one canvas for performance.
   Cubes react to scroll: they drift, rotate faster, and shift
   position as the user scrolls down the page.
================================================================ */
(function () {
  const canvas = document.getElementById('main-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let W, H, dpr;
  let scrollY = 0;
  let mouseX = W / 2, mouseY = H / 2;

  const GREEN_RGB = '22,163,74';

  /* ---- resize ---- */
  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth;
    H = window.innerHeight;
    canvas.width  = W * dpr;
    canvas.height = H * dpr;
    canvas.style.width  = W + 'px';
    canvas.style.height = H + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  /* ================================================================
     CUBE SYSTEM
  ================================================================ */
  const NUM_CUBES = 9;
  const cubes = [];

  function makeCube() {
    return {
      // world position (0-1 of screen, extended beyond edges)
      x: Math.random() * 1.4 - 0.2,
      y: Math.random() * 2.0,          // spread over 2x page height
      z: 80 + Math.random() * 140,     // depth (size factor)
      rx: Math.random() * Math.PI * 2, // rotation angles
      ry: Math.random() * Math.PI * 2,
      rz: Math.random() * Math.PI * 2,
      // per-cube spin speeds (gentle)
      vx: (Math.random() - 0.5) * 0.004,
      vy: (Math.random() - 0.5) * 0.006,
      vz: (Math.random() - 0.5) * 0.003,
      opacity: 0.06 + Math.random() * 0.10,
      scrollSpeed: 0.3 + Math.random() * 0.5, // parallax factor
    };
  }

  for (let i = 0; i < NUM_CUBES; i++) cubes.push(makeCube());

  /* Project a 3-D point [x,y,z] (cube-local) onto screen 2-D.
     cx,cy = screen center of the cube; half = half-size of cube */
  function project(lx, ly, lz, cx, cy, perspective) {
    // simple perspective divide
    const scale = perspective / (perspective + lz);
    return {
      x: cx + lx * scale,
      y: cy + ly * scale,
      s: scale,
    };
  }

  /* Rotate a point around three axes */
  function rotate3D(x, y, z, rx, ry, rz) {
    // X axis
    let y1 = y * Math.cos(rx) - z * Math.sin(rx);
    let z1 = y * Math.sin(rx) + z * Math.cos(rx);
    // Y axis
    let x2 = x * Math.cos(ry) + z1 * Math.sin(ry);
    let z2 = -x * Math.sin(ry) + z1 * Math.cos(ry);
    // Z axis
    let x3 = x2 * Math.cos(rz) - y1 * Math.sin(rz);
    let y3 = x2 * Math.sin(rz) + y1 * Math.cos(rz);
    return { x: x3, y: y3, z: z2 };
  }

  function drawCube(cube) {
    const size = cube.z;
    const cx = cube.x * W;
    // cy moves with scroll at each cube's individual parallax speed
    const cy = (cube.y * H * 2) - (scrollY * cube.scrollSpeed);
    const persp = 600;

    // Only draw if near visible area (skip offscreen cubes)
    if (cy < -size * 2 || cy > H + size * 2) return;

    // 8 vertices of a unit cube, scaled by size/2
    const h = size / 2;
    const rawVerts = [
      [-h,-h,-h],[h,-h,-h],[h,h,-h],[-h,h,-h],
      [-h,-h, h],[h,-h, h],[h,h, h],[-h,h, h],
    ];

    // gentle mouse parallax tilt on top of rotation
    const mx = ((mouseX / W) - 0.5) * 0.1;
    const my = ((mouseY / H) - 0.5) * 0.1;

    const verts2D = rawVerts.map(([x,y,z]) => {
      const r = rotate3D(x, y, z,
        cube.rx + my,
        cube.ry + mx,
        cube.rz);
      return project(r.x, r.y, r.z, cx, cy, persp);
    });

    // 12 edges of a cube (pairs of vertex indices)
    const edges = [
      [0,1],[1,2],[2,3],[3,0], // back face
      [4,5],[5,6],[6,7],[7,4], // front face
      [0,4],[1,5],[2,6],[3,7], // connectors
    ];

    ctx.save();
    ctx.strokeStyle = `rgba(${GREEN_RGB},${cube.opacity})`;
    ctx.lineWidth = 1.2;
    ctx.lineCap = 'round';

    edges.forEach(([a, b]) => {
      const p1 = verts2D[a];
      const p2 = verts2D[b];
      ctx.beginPath();
      ctx.moveTo(p1.x, p1.y);
      ctx.lineTo(p2.x, p2.y);
      ctx.stroke();
    });

    // faint face fill on the "top" face for depth feel
    const topFace = [verts2D[4], verts2D[5], verts2D[6], verts2D[7]];
    ctx.beginPath();
    ctx.moveTo(topFace[0].x, topFace[0].y);
    topFace.forEach(p => ctx.lineTo(p.x, p.y));
    ctx.closePath();
    ctx.fillStyle = `rgba(${GREEN_RGB},${cube.opacity * 0.25})`;
    ctx.fill();

    ctx.restore();
  }

  /* ================================================================
     BUBBLE SYSTEM
  ================================================================ */
  function bubbleCount() {
    return Math.max(14, Math.min(Math.round((W * H) / 32000), 50));
  }

  const bubbles = [];

  function makeBubble() {
    const r = 5 + Math.random() * 20;
    return {
      x: Math.random() * W,
      y: Math.random() * H,
      r,
      vy: 0.22 + Math.random() * 0.5,
      driftPhase: Math.random() * Math.PI * 2,
      driftSpeed: 0.15 + Math.random() * 0.28,
      driftAmp: 6 + Math.random() * 14,
      opacity: 0.05 + Math.random() * 0.13,
      offX: 0, offY: 0,
    };
  }

  const MOUSE_RADIUS = 130;
  let mouse = { x: -9999, y: -9999, active: false };

  function initBubbles() {
    const n = bubbleCount();
    bubbles.length = 0;
    for (let i = 0; i < n; i++) bubbles.push(makeBubble());
  }

  function drawBubble(b) {
    const drawX = b.x + b.offX;
    const drawY = b.y + b.offY;
    ctx.beginPath();
    ctx.arc(drawX, drawY, b.r, 0, Math.PI * 2);
    ctx.fillStyle = `rgba(${GREEN_RGB},${b.opacity})`;
    ctx.fill();
    if (b.r > 12) {
      ctx.strokeStyle = `rgba(${GREEN_RGB},${b.opacity * 1.5})`;
      ctx.lineWidth = 0.8;
      ctx.stroke();
    }
  }

  /* ================================================================
     MAIN LOOP
  ================================================================ */
  let lastTime = 0;
  function frame(time) {
    const dt = Math.min(time - lastTime, 32); // cap at ~30fps equivalent
    lastTime = time;

    ctx.clearRect(0, 0, W, H);

    /* --- update & draw cubes --- */
    const scrollFactor = 1 + Math.min(scrollY / 1200, 1.2); // faster spin on scroll
    cubes.forEach(cube => {
      cube.rx += cube.vx * scrollFactor;
      cube.ry += cube.vy * scrollFactor;
      cube.rz += cube.vz * scrollFactor;
      drawCube(cube);
    });

    /* --- update & draw bubbles --- */
    bubbles.forEach(b => {
      b.y -= b.vy;
      b.x += Math.sin(time * 0.001 * b.driftSpeed + b.driftPhase) * b.driftAmp * 0.01;

      if (mouse.active) {
        const dx = b.x + b.offX - mouse.x;
        const dy = b.y + b.offY - mouse.y;
        const dist = Math.hypot(dx, dy);
        if (dist < MOUSE_RADIUS && dist > 0.01) {
          const force = (1 - dist / MOUSE_RADIUS) * 16;
          b.offX += (dx / dist) * force * 0.1;
          b.offY += (dy / dist) * force * 0.1;
        }
      }
      b.offX *= 0.93;
      b.offY *= 0.93;

      if (b.y + b.r < -20) {
        b.y = H + b.r + Math.random() * 40;
        b.x = Math.random() * W;
        b.offX = 0; b.offY = 0;
      }

      drawBubble(b);
    });

    if (!prefersReducedMotion) requestAnimationFrame(frame);
  }

  /* ================================================================
     EVENT LISTENERS
  ================================================================ */
  window.addEventListener('scroll', () => { scrollY = window.scrollY; }, { passive: true });
  window.addEventListener('mousemove', e => {
    mouse.x = e.clientX; mouse.y = e.clientY; mouse.active = true;
    mouseX = e.clientX; mouseY = e.clientY;
  }, { passive: true });
  window.addEventListener('mouseleave', () => { mouse.active = false; });
  window.addEventListener('touchmove', e => {
    if (e.touches[0]) { mouse.x = e.touches[0].clientX; mouse.y = e.touches[0].clientY; mouse.active = true; }
  }, { passive: true });

  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => { resize(); initBubbles(); }, 150);
  });

  /* ================================================================
     INIT
  ================================================================ */
  resize();
  initBubbles();

  if (prefersReducedMotion) {
    frame(0); // single static frame
  } else {
    requestAnimationFrame(frame);
  }
})();
