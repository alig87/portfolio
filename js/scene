/* ================================================================
   SCENE.JS — floating bubbles (cubes removed)
   Drawn on one canvas (#main-canvas) for performance.
================================================================ */
(function () {
  const canvas = document.getElementById('main-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let W, H, dpr;
  const GREEN_RGB = '22,163,74';
  const MOUSE_RADIUS = 130;
  const mouse = { x: -9999, y: -9999, active: false };
  const bubbles = [];

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth;
    H = window.innerHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function bubbleCount() {
    return Math.max(14, Math.min(Math.round((W * H) / 32000), 50));
  }

  function makeBubble() {
    return {
      x: Math.random() * W,
      y: Math.random() * H,
      r: 5 + Math.random() * 20,
      vy: 0.22 + Math.random() * 0.5,
      driftPhase: Math.random() * Math.PI * 2,
      driftSpeed: 0.15 + Math.random() * 0.28,
      driftAmp: 6 + Math.random() * 14,
      opacity: 0.05 + Math.random() * 0.13,
      offX: 0,
      offY: 0,
    };
  }

  function initBubbles() {
    bubbles.length = 0;
    const n = bubbleCount();
    for (let i = 0; i < n; i++) bubbles.push(makeBubble());
  }

  function drawBubble(b) {
    const x = b.x + b.offX;
    const y = b.y + b.offY;
    ctx.beginPath();
    ctx.arc(x, y, b.r, 0, Math.PI * 2);
    ctx.fillStyle = `rgba(${GREEN_RGB},${b.opacity})`;
    ctx.fill();
    if (b.r > 12) {
      ctx.strokeStyle = `rgba(${GREEN_RGB},${b.opacity * 1.5})`;
      ctx.lineWidth = 0.8;
      ctx.stroke();
    }
  }

  function frame(time) {
    ctx.clearRect(0, 0, W, H);

    bubbles.forEach(b => {
      b.y -= b.vy;
      b.x += Math.sin(time * 0.001 * b.driftSpeed + b.driftPhase) * b.driftAmp * 0.01;

      if (mouse.active) {
        const dx = b.x + b.offX - mouse.x;
        const dy = b.y + b.offY - mouse.y;
        const dist = Math.hypot(dx, dy);
        if (dist < MOUSE_RADIUS && dist > 0.01) {
          const force = (1 - dist / MOUSE_RADIUS) * 16;
          b.offX += (dx / dist) * force * 0.1;
          b.offY += (dy / dist) * force * 0.1;
        }
      }
      b.offX *= 0.93;
      b.offY *= 0.93;

      if (b.y + b.r < -20) {
        b.y = H + b.r + Math.random() * 40;
        b.x = Math.random() * W;
        b.offX = 0;
        b.offY = 0;
      }
      drawBubble(b);
    });

    if (!prefersReducedMotion) requestAnimationFrame(frame);
  }

  window.addEventListener('mousemove', e => {
    mouse.x = e.clientX; mouse.y = e.clientY; mouse.active = true;
  }, { passive: true });
  window.addEventListener('mouseleave', () => { mouse.active = false; });
  window.addEventListener('touchmove', e => {
    if (e.touches[0]) { mouse.x = e.touches[0].clientX; mouse.y = e.touches[0].clientY; mouse.active = true; }
  }, { passive: true });

  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => { resize(); initBubbles(); }, 150);
  });

  resize();
  initBubbles();
  if (prefersReducedMotion) frame(0);
  else requestAnimationFrame(frame);
})();
